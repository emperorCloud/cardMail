# CARDMail — variables d'environnement (Vercel → Project Settings → Environment Variables)
# Ne jamais inscrire de secrets réels dans ce fichier.

# Neon (intégration Vercel Marketplace → injecte DATABASE_URL automatiquement)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Vercel Blob (créer un store en accès PRIVÉ, le connecter au projet)
BLOB_READ_WRITE_TOKEN=""

# Resend
RESEND_API_KEY="re_your_resend_api_key"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Secret de signature des sessions (OBLIGATOIRE, ≥ 32 caractères) : openssl rand -hex 32
AUTH_SECRET=""

# Web Push (OBLIGATOIRE si notifications) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cardit.cm"

# Premier administrateur, créé uniquement si la base est vide (à retirer après la première connexion)
BOOTSTRAP_ADMIN_EMAIL="admin@cardit.cm"
BOOTSTRAP_ADMIN_PASSWORD=""

# Développement local uniquement : comptes de démonstration (voir README)
SEED_DEMO="false"
